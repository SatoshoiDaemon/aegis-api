{
  "name": "aegis-api",
  "version": "1.0.0",
  "description": "Secure authentication microservice with session rotation and audit logging",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "test": "jest --testPathIgnorePatterns=/integration/ --runInBand",
    "test:all": "jest --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=/integration/ --runInBand",
    "test:integration": "jest src/integration --runInBand",
    "test:containers": "docker compose up -d --wait && DATABASE_URL=postgresql://root:password@localhost:5432/auth_db REDIS_URL=redis://localhost:6379/15 NODE_ENV=test corepack pnpm exec prisma migrate deploy && DATABASE_URL=postgresql://root:password@localhost:5432/auth_db REDIS_URL=redis://localhost:6379/15 NODE_ENV=test corepack pnpm run test:integration",
    "test:containers:down": "docker compose down -v",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "sdk:build": "tsc -p packages/sdk/tsconfig.json",
    "test:load": "node scripts/load.mjs",
    "test:oidc": "pnpm build && node scripts/test-oidc.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/request-context": "^6.2.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "oidc-provider": "9.12.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.2.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
