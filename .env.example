PORT=3333
NODE_ENV=development
API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

DATABASE_URL=postgresql://root:password@localhost:5432/auth_db
REDIS_URL=redis://localhost:6379

# Required only in production. Store PEM values as single-line strings with \n escapes.
PRIVATE_KEY=
PUBLIC_KEY=

# Stable issuer/audience. HTTPS issuer is required with NODE_ENV=production.
JWT_ISSUER=http://localhost:3333
JWT_AUDIENCE=aegis-api
DB_POOL_MAX=20
METRICS_TOKEN=

# Mail adapter: consumes {to,type,token,expiresAt} and sends your frontend link.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
AUDIT_RETENTION_DAYS=90
# Keep 1 in production. Controlled disposable benchmarks may explicitly raise it.
RATE_LIMIT_FACTOR=1

# Optional OIDC provider. See docs/oidc.md before enabling.
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:3333/oidc
OIDC_UI_URL=http://localhost:3000/identity
OIDC_CLIENTS=[]
OIDC_COOKIE_KEYS=[]
OIDC_TRUST_PROXY=false
