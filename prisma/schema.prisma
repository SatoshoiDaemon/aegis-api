generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAIL
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  LOGOUT
  PASSWORD_RESET
}

enum Severity {
  INFO
  WARN
  CRITICAL
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  isVerified    Boolean        @default(false) @map("is_verified")
  role          Role           @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at")

  sessions      Session[]
  emailTokens   EmailToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @default(uuid()) @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model EmailToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  type       TokenType
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model AuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String?      @map("user_id") @db.Uuid
  action        AuditAction
  severity      Severity     @default(INFO)
  ip            String?
  userAgent     String?      @map("user_agent")
  correlationId String?      @map("correlation_id")
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([correlationId])
  @@map("audit_logs")
}

// Durable adapter for the optional standards-based OIDC provider.
model OidcRecord {
  model      String
  id         String
  payload    Json
  uid        String?
  grantId    String?
  accountId  String?
  expiresAt  DateTime?
  consumedAt Int?
  @@id([model, id])
  @@index([model, uid])
  @@index([grantId])
  @@index([accountId])
  @@index([expiresAt])
  @@map("oidc_records")
}
